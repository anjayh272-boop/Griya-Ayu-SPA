rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && data.pass is string && data.pass.size() >= 1 && data.pass.size() <= 120
        && data.points is number && data.points >= 0 && data.points <= 1000000;
    }

    function isValidBooking(data) {
      return data.id is number
        && data.customer is string && data.customer.size() >= 1 && data.customer.size() <= 120
        && data.wa is string && data.wa.size() >= 5 && data.wa.size() <= 30
        && data.items is string && data.items.size() >= 1 && data.items.size() <= 500
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
        && data.time is string && data.time.size() >= 4 && data.time.size() <= 10
        && data.total is number && data.total >= 0 && data.total <= 100000000
        && data.paymentStatus is string && data.paymentStatus.size() <= 60
        && data.status is string && data.status.size() <= 40;
    }

    function isValidNotification(data) {
      return data.id is number
        && data.target is string && data.target.size() <= 30
        && data.type is string && data.type.size() <= 40
        && data.title is string && data.title.size() <= 300
        && data.message is string && data.message.size() <= 3000
        && data.read is bool;
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /griya_customers/{phoneId} {
      allow get, list: if true;
      allow create, update: if isValidId(phoneId) && isValidCustomer(incoming());
      allow delete: if isValidId(phoneId);
    }

    match /griya_bookings/{bookingId} {
      allow get, list: if true;
      allow create, update: if isValidId(bookingId) && isValidBooking(incoming());
      allow delete: if isValidId(bookingId);
    }

    match /griya_notifications/{notifId} {
      allow get, list: if true;
      allow create, update: if isValidId(notifId) && isValidNotification(incoming());
      allow delete: if isValidId(notifId);
    }

    match /griya_config/{configId} {
      allow get, list: if true;
      allow create, update: if isValidId(configId);
      allow delete: if isValidId(configId);
    }
  }
}
